{
  "version": 2,
  "builds": [
    {
      "src": "cybersecurity-dashboard-2/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "cybersecurity-dashboard-2/$1"
    }
  ],
  "functions": {
    "cybersecurity-dashboard-2/app/api/v1/**/*.ts": {
      "runtime": "edge"
    }
  }
}